# Copy to .env once, then replace both placeholders with Midtrans Sandbox keys.
# Keep this file private: chmod 600 .env. The real .env is ignored by git.
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME
MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE_ME
MIDTRANS_IS_PRODUCTION=false
# Use the public HTTPS customer URL in deployment; localhost is only for local testing.
MIDTRANS_FINISH_URL=http://localhost:8090/order-history.html
# Remove this line to use the complete default allowlist.
MIDTRANS_ENABLED_PAYMENTS=credit_card,dana,other_qris,bca_va,bri_va,bni_va,permata_va,echannel,cimb_va,indomaret,alfamart

# MySQL used by the customer app. Create/import schema.sql in phpMyAdmin first.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fazima_print_customer
MYSQL_USER=fazima_customer_app
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Firebase Web App config (public client config; enable Google provider in Firebase Console)
FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=fazimaprint-e52ef
FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID
